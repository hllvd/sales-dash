# Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies
COPY client/sales-dash/package*.json ./
RUN npm ci

# Build the app
COPY client/sales-dash/ ./

ARG REACT_APP_AWS_RUM_APP_ID
ARG REACT_APP_AWS_REGION
ARG REACT_APP_AWS_RUM_IDENTITY_POOL_ID
ARG REACT_APP_BUILD_ID
ARG GENERATE_SOURCEMAP=true

ENV REACT_APP_AWS_RUM_APP_ID=$REACT_APP_AWS_RUM_APP_ID
ENV REACT_APP_AWS_REGION=$REACT_APP_AWS_REGION
ENV REACT_APP_AWS_RUM_IDENTITY_POOL_ID=$REACT_APP_AWS_RUM_IDENTITY_POOL_ID
ENV REACT_APP_BUILD_ID=$REACT_APP_BUILD_ID
ENV GENERATE_SOURCEMAP=$GENERATE_SOURCEMAP

RUN npm run build

# Export stage — just serves its build directory for the outer nginx
FROM nginx:alpine
COPY --from=build /app/build /usr/share/nginx/html

# SPA fallback: all unknown paths return index.html so React Router works
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  index index.html;\n  location / {\n    try_files $uri $uri/ /index.html;\n  }\n}\n' \
    > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
