# pbi-scraper worker environment configuration
NODE_ENV=development

# AWS SQS Configuration (leave SQS_JOBS_QUEUE_URL empty for local file-based mock queue)
SQS_JOBS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/797163826126/hdev-sales-scrape-jobs
SQS_RESULTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/797163826126/hdev-sales-dash
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# S3 Configuration for Scrape Output CSVs
SCRAPE_S3_BUCKET=hdev-sales-dash
SCRAPE_S3_PREFIX=scrape-results/

# Encryption Key (32-byte / 64-character hex string for password AES-256-GCM)
SCRAPER_ENCRYPTION_KEY=

# Optional Callback Target (SalesApp.Api endpoint)
CALLBACK_BASE_URL=http://salesapp-api:5000

# Worker Scale-to-Zero and Polling Behavior
SCALE_TO_ZERO=true
IDLE_TIMEOUT_MS=300000
OUTPUT_DIR=./outputs

