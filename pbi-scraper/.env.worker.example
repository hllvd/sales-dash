# pbi-scraper worker environment configuration
NODE_ENV=development

# AWS SQS Configuration (leave empty for local file-based mock queue)
SQS_QUEUE_URL=
AWS_REGION=us-east-1
AWS_PROFILE=default

# Encryption Key (32-byte / 64-character hex string matching C# SCRAPER_ENCRYPTION_KEY)
SCRAPER_ENCRYPTION_KEY=

# Callback Target (SalesApp.Api endpoint)
CALLBACK_BASE_URL=http://salesapp-api:5000

# Worker Scale-to-Zero and Polling Behavior
SCALE_TO_ZERO=false
MAX_EMPTY_POLLS=3
OUTPUT_DIR=./outputs
