# URL da fila SQS criada na AWS
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/<ID_DA_CONTA>/salesapp-scrape-results

# Região da AWS
AWS_REGION=us-east-1

# Credenciais AWS (opcional se configuradas via AWS CLI / ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# URL da API do SalesApp (local)
API_BASE_URL=http://localhost:5001

# Segredo compartilhado com a API (opcional)
API_SECRET=

# Se true, encerra o worker após MAX_EMPTY_POLLS sem mensagens
SCALE_TO_ZERO=false
MAX_EMPTY_POLLS=3

# Tempo que a mensagem fica invisível durante o processamento (segundos)
VISIBILITY_TIMEOUT=300
