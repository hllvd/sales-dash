# rclone configuration for S3 backup
#
# 1. Copy this file to rclone.conf on the server:
#       cp rclone.conf.example rclone.conf
#
# 2. Fill in your AWS credentials and settings below.
#
# 3. Make sure the docker-compose backup service mounts this file:
#       volumes:
#         - ./backup:/config
#
# ─── DO NOT COMMIT rclone.conf — it contains secrets ────────────────────────

[mys3]
type = s3
provider = AWS
access_key_id = YOUR_ACCESS_KEY_ID
secret_access_key = YOUR_SECRET_ACCESS_KEY
region = us-east-1
# endpoint = s3.us-east-1.amazonaws.com   # optional; needed for non-AWS S3 providers
# Required when using a restricted IAM policy (no s3:CreateBucket permission).
# Tells rclone to skip the bucket-exists check and assume the bucket is already created.
no_check_bucket = true
